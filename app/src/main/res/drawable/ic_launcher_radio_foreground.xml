<?xml version="1.0" encoding="utf-8"?>
<!-- Передний слой адаптивной иконки (Android 8+): магнитола, нарисованная автором приложения, в векторе.
     Раньше слой был картинкой webp пяти размеров с тонкими линиями: на рабочем столе (иконка около 48 dp)
     они почти пропадали. Здесь тот же рисунок, линии толще (3 вместо ~1,3), и он чёткий на любом экране.

     Тот же файл служит слоем monochrome - для "тематических иконок" Android 13+: система берёт у него только
     форму (прозрачность), а цвет подставляет из обоев. Поэтому корпус нигде не залит - видны только линии.

     Как устроен размер: адаптивная иконка - 108 x 108 dp, но лаунчер показывает только середину 72 x 72
     и обрезает её по своей форме (круг, квадрат, "капля"). Гарантированно видна только серединка диаметром 66 dp,
     поэтому магнитола (нарисована в координатах 140 x 90, как store-assets/boombox.svg) уменьшена группой
     до scale 0.47 и поставлена в центр: так даже кончики "звука" по бокам не обрежутся круглой маской -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.47"
        android:scaleY="0.47"
        android:translateX="21.1"
        android:translateY="34.3">

        <!-- Шарик на антенне -->
        <path
            android:fillColor="#FF7A22"
            android:pathData="M107.4,8 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0 Z" />

        <!-- Все линии рисунка одним контуром: антенна, ручка, корпус, динамики, шкала, кассета, звук -->
        <path
            android:pathData="M110,10 L110,33
                M41,33 V17 H99 V33
                M20,33 H120 V79 H20 Z
                M25,56 a17,17 0 1,0 34,0 a17,17 0 1,0 -34,0 Z
                M33.5,49.5 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z
                M81,56 a17,17 0 1,0 34,0 a17,17 0 1,0 -34,0 Z
                M100.5,62.5 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z
                M61,39 H79 V45 H61 Z
                M61,50 H79 V73 H61 Z
                M14,47 L8.5,41.5 M14,56 L5,57 M14,64 L9,68.5
                M126,47 L131.5,41.5 M126,56 L135,55 M126,64 L131,68.5"
            android:strokeWidth="3"
            android:strokeColor="#FF7A22"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
