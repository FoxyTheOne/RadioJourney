                android:layout_gravity="center"
                android:padding="@dimen/space_beforeOrAfterElement"
                android:text="@string/homeRadio_selectRadioStation" />

        </LinearLayout>
        -->

        <!-- Кнопки сразу под заголовком: информационный блок ниже можно закрыть, а кнопки при этом остаются на месте -->
        <LinearLayout
            android:id="@+id/linear_radioStationButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_transparent"
            android:gravity="end"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_beforeOrAfterElement"
            android:paddingBottom="@dimen/space_beforeOrAfterElement"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Мои радиостанции: список, который пользователь собирает сам, по ссылкам на потоки.
                 Кнопка рядом с избранным и такая же по оформлению - это два родственных списка -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_goToMyStations"
                style="@style/Widget.AppCompat.ActionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_small"
                android:background="@drawable/button_rounded_corners"
                android:text="@string/homeRadio_goToMyStations"
                android:textColor="@color/white"
                android:textSize="@dimen/button_text"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_goToFavourites"
                style="@style/Widget.AppCompat.ActionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_beforeOrAfterElement"
                android:background="@drawable/button_rounded_corners"
                android:text="@string/homeRadio_goToFavourites"
                android:textColor="@color/white"
                android:textSize="@dimen/button_text"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- "О программе": там же можно перечитать текст информационного блока -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image_settings"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/space_small"
            android:scaleType="centerCrop"
            android:src="@drawable/outline_info_24"
            app:layout_constraintBottom_toBottomOf="@+id/linear_radioStationButtons"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/linear_radioStationButtons" />

        <!-- Информационный блок: не срочный текст, поэтому не диалог (он закрывал бы экран), а полоса под кнопками.
             Прочитал - закрыл крестиком навсегда (запоминается в настройках). Перечитать можно в "О программе".
             Скрыт, пока настройка не прочитана: иначе у закрывших его блок мелькал бы при каждом открытии карты -->
        <LinearLayout
            android:id="@+id/linear_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_transparent"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linear_radioStationButtons">

            <!-- Линия отделяет текст от кнопок и исчезает вместе с текстом -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/line_info"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/space_beforeOrAfterElement"
                android:layout_marginEnd="@dimen/space_beforeOrAfterElement"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_baseline_horizontal_rule_24" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_small"
                    android:paddingBottom="@dimen/space_small">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/text_canTakeTime"
                        style="@style/login_bottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/space_beforeOrAfterElement"
                        android:paddingEnd="0dp"
                        android:text="@string/first_screen_text3" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/text_mayNotWork"
                        style="@style/login_bottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/space_beforeOrAfterElement"
                        android:paddingEnd="0dp"
                        android:text="@string/homeRadio_mayNotWork" />
                </LinearLayout>

                <!-- Крестик 48x48dp - минимальный размер области нажатия по Material Design, сама иконка 24dp -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/button_closeInfo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/space_small"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/homeRadio_closeInfo"
                    android:padding="12dp"
                    android:src="@drawable/ic_baseline_close_24" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/button_zoomPlus"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_beforeOrAfterElement"
            android:layout_marginBottom="@dimen/space_small"
            android:text="@string/homeRadio_zoomPlus"
            android:textColor="@color/white_transparent_80"
            app:backgroundTint="@color/orange_transparent"
            app:layout_constraintBottom_toTopOf="@+id/button_zoomMinus"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/button_zoomMinus"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_beforeOrAfterElement"
            android:layout_marginBottom="@dimen/space_small"
            android:text="@string/homeRadio_zoomMinus"
            android:textColor="@color/white_transparent_80"
            app:backgroundTint="@color/orange_transparent"
            app:layout_constraintBottom_toTopOf="@+id/button_youAreHere"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/button_youAreHere"
            style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_beforeOrAfterElement"
            android:layout_marginBottom="@dimen/space_beforeOrAfterElement"
            android:contentDescription="@string/homeRadio_youAreHere"
            app:backgroundTint="@color/orange_transparent"
            app:icon="@drawable/marker"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="@color/white_transparent_80"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- layout для ProgressBar -->
        <FrameLayout
            android:id="@+id/frameLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black_transparent_22"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressCircular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_loadingData"
            style="@style/login_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Loading data..."
            android:textColor="@color/black"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <ProgressBar
            android:id="@+id/progressCircularLoadingArguments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/orange"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>