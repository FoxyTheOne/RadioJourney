                android:layout_marginStart="@dimen/space_beforeOrAfterElement" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_radioStationTitle"
                style="@style/login_title"
                android:layout_width="wrap_content"
