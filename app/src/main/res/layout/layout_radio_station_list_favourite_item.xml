<?xml version="1.0" encoding="utf-8"?><!-- Элемент списка избранного: сверху заголовок страны (виден только у первой станции страны, см. FavoriteListAdapter),
     под ним строка станции. Заголовок вынесен из строки станции: так он не нажимается вместе со станцией,
     а звезда стоит напротив названия станции, а не посередине между заголовком и станцией -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background"
    android:orientation="vertical">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_radioStationCity"
        style="@style/title_default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_beforeOrAfterElement"
        android:paddingTop="@dimen/space_32"
        android:paddingEnd="@dimen/space_beforeOrAfterElement"
        app:textAllCaps="true"
        tools:text="Radio station COUNTRY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/linear_stationDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_beforeOrAfterElement">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_radioStationName"
                style="@style/login_bottom_orange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingStart="@dimen/space_beforeOrAfterElement"
                android:paddingEnd="@dimen/space_beforeOrAfterElement"
                tools:text="Radio station NAME" />

            <LinearLayout
                android:id="@+id/linear_radioStationClickCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_radioStationClickCount"
                    style="@style/login_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/space_beforeOrAfterElement"
                    android:text="@string/radioStationList_count" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_radioStationClickCount2"
                    style="@style/login_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/space_beforeOrAfterElement"
                    android:paddingEnd="@dimen/space_beforeOrAfterElement"
                    tools:text="2" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear_imageStar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="end"
            android:paddingTop="@dimen/space_beforeOrAfterElement">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image_star"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/space_small"
                android:layout_marginEnd="@dimen/space_beforeOrAfterElement" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>