# Настройки Android Studio: у каждого компьютера они свои (пути к AVD и JDK, масштаб редактора,
# последнее выбранное устройство). Студия создаёт их заново сама
.idea/

# Ключ подписи приложения и пароли к нему: у того, кто их получит, будет возможность
# выпускать обновления приложения от имени автора
keystore.properties
*.jks
*.keystore
